@page "/admin/wheel"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<section class="fate-wheel">
    <header class="fate-wheel__header">
        <p class="fate-wheel__eyebrow">이벤트</p>
        <h3 class="fate-wheel__title">운명의 회전판</h3>
        <p class="fate-wheel__subtitle">버튼을 누르면 확률에 따라 보상이 선택됩니다.</p>
    </header>

    <div class="fate-wheel__stage">
        <div class="fate-wheel__pointer" aria-hidden="true"></div>
        <div class="fate-wheel__wheel"
             style="@WheelStyle"
             aria-label="운명의 회전판"></div>
    </div>

    <button class="fate-wheel__spin" @onclick="SpinAsync" disabled="@isSpinning">돌리기</button>

    @if (!string.IsNullOrWhiteSpace(resultMessage))
    {
        <p class="fate-wheel__result">결과: @resultMessage</p>
    }

    <ul class="fate-wheel__legend">
        @foreach (var item in Items)
        {
            <li>
                <span class="fate-wheel__dot" style="background:@item.Color"></span>
                @item.Name (@item.Weight%)
            </li>
        }
    </ul>
</section>

@code {
    private readonly IReadOnlyList<WheelItem> Items = new List<WheelItem>
    {
        new("수호의 요새 7강화", 10, "#ef4444"),
        new("레이저건 1강화", 35, "#3b82f6"),
        new("꽝", 13, "#6b7280"),
        new("공격의 거대광선 7강화", 7, "#f59e0b"),
        new("수호의 벙커 2강화", 35, "#22c55e")
    };

    private bool isSpinning;
    private string? resultMessage;
    private double rotationDegrees;

    private string WheelStyle => $"transform: rotate({rotationDegrees}deg); background: {BuildWheelBackground()};";

    private async Task SpinAsync()
    {
        if (isSpinning)
        {
            return;
        }

        isSpinning = true;
        resultMessage = null;

        var selectedIndex = PickWeightedIndex();
        var selected = Items[selectedIndex];
        var selectedCenter = GetSegmentCenterAngle(selectedIndex);

        var current = rotationDegrees % 360;
        if (current < 0)
        {
            current += 360;
        }

        var target = (360 - selectedCenter) % 360;
        var delta = (target - current + 360) % 360;
        rotationDegrees += (360 * 5) + delta;

        await Task.Delay(4600);

        isSpinning = false;
        resultMessage = selected.Name;
    }

    private int PickWeightedIndex()
    {
        var totalWeight = Items.Sum(i => i.Weight);
        var roll = Random.Shared.Next(1, totalWeight + 1);
        var cumulative = 0;
        for (var i = 0; i < Items.Count; i++)
        {
            cumulative += Items[i].Weight;
            if (roll <= cumulative)
            {
                return i;
            }
        }

        return Items.Count - 1;
    }

    private double GetSegmentCenterAngle(int index)
    {
        var totalWeight = Items.Sum(i => i.Weight);
        double cursor = 0;
        for (var i = 0; i < index; i++)
        {
            cursor += GetSliceAngle(Items[i].Weight, totalWeight);
        }

        return cursor + (GetSliceAngle(Items[index].Weight, totalWeight) / 2.0);
    }

    private string BuildWheelBackground()
    {
        var slices = new List<string>();
        double cursorPercent = 0;

        foreach (var item in Items)
        {
            var nextPercent = cursorPercent + item.Weight;
            slices.Add($"{item.Color} {cursorPercent:F3}% {nextPercent:F3}%");
            cursorPercent = nextPercent;
        }

        return $"conic-gradient(from -90deg, {string.Join(", ", slices)})";
    }

    private static double GetSliceAngle(int weight, int totalWeight)
    {
        return (weight * 360.0) / totalWeight;
    }

    private sealed record WheelItem(string Name, int Weight, string Color);
}
