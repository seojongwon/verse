@page "/admin/wheel"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Threading

<section class="fate-wheel">
    <header class="fate-wheel__header">
        <p class="fate-wheel__eyebrow">이벤트</p>
        <h3 class="fate-wheel__title">운명의 회전판</h3>
        <p class="fate-wheel__subtitle">버튼을 누르면 확률에 따라 보상이 선택됩니다.</p>
    </header>

    <div class="fate-wheel__stage">
        <div class="fate-wheel__pointer" aria-hidden="true"></div>
        <div class="fate-wheel__rim" aria-hidden="true"></div>
        <div class="fate-wheel__wheel"
             style="@WheelStyle"
             aria-label="운명의 회전판">
            @foreach (var label in LabelPositions)
            {
                <span class="fate-wheel__label" style="@label.Style">@label.Text</span>
            }
        </div>
        <div class="fate-wheel__hub" aria-hidden="true"></div>
    </div>

    <div class="fate-wheel__charge">
        <div class="fate-wheel__charge-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@chargePercent">
            <div class="fate-wheel__charge-fill" style="width:@($"{chargePercent:0}%")"></div>
        </div>
    </div>

    <button class="fate-wheel__spin"
            @onpointerdown="StartCharge"
            @onpointerup="ReleaseSpinAsync"
            @onpointercancel="CancelCharge"
            disabled="@isSpinning">
        @(isCharging ? "충전 중..." : "길게 눌러 돌리기")
    </button>

    @if (!string.IsNullOrWhiteSpace(resultMessage))
    {
        <p class="fate-wheel__result">결과: @resultMessage</p>
    }

    <ul class="fate-wheel__legend">
        @foreach (var item in Items)
        {
            <li>
                <span class="fate-wheel__dot" style="background:@item.Color"></span>
                @item.Name
            </li>
        }
    </ul>
</section>

@code {
    private readonly IReadOnlyList<WheelItem> Items = new List<WheelItem>
    {
        new("수호의 요새 7강화", "요새 7강화", 20, "#ef4444"),
        new("레이저건 1강화", "레이저건 1강화", 20, "#3b82f6"),
        new("꽝", "꽝", 20, "#6b7280"),
        new("수호의 벙커 1강화", "벙커 1강화", 20, "#14b8a6"),
        new("레이저건 2강화", "레이저건 2강화", 20, "#2563eb"),
        new("수호의 요새 8강화", "요새 8강화", 20, "#a855f7"),
        new("공격의 거대광선 7강화", "거대광선 7강화", 20, "#f59e0b"),
        new("수호의 벙커 3강화", "벙커 3강화", 20, "#22c55e")
    };

    private bool isSpinning;
    private bool isCharging;
    private string? resultMessage;
    private double rotationDegrees;
    private double labelRotationDegrees;
    private double chargePercent;
    private int spinDurationMs = 4600;
    private CancellationTokenSource? chargeCts;

    private string WheelStyle => $"transform: rotate({rotationDegrees}deg); background: {BuildWheelBackground()}; transition: transform {spinDurationMs}ms cubic-bezier(0.08, 0.82, 0.14, 1);";

    private IReadOnlyList<LabelInfo> LabelPositions
    {
        get
        {
            var labels = new List<LabelInfo>();
            var totalWeight = Items.Sum(i => i.Weight);
            double cursor = 0;
            foreach (var item in Items)
            {
                var span = GetSliceAngle(item.Weight, totalWeight);
                var center = cursor + (span / 2.0);
                var radians = (center - 90.0) * Math.PI / 180.0;
                var x = 50 + (34 * Math.Cos(radians));
                var y = 50 + (34 * Math.Sin(radians));
                labels.Add(new LabelInfo(item.ShortLabel, $"left:{x:F2}%;top:{y:F2}%;--label-rotation:{labelRotationDegrees:F2}deg;"));
                cursor += span;
            }

            return labels;
        }
    }

    private void StartCharge(PointerEventArgs e)
    {
        if (isSpinning || isCharging)
        {
            return;
        }

        isCharging = true;
        resultMessage = null;
        chargePercent = 0;
        chargeCts?.Cancel();
        chargeCts = new CancellationTokenSource();
        _ = RunChargeLoopAsync(chargeCts.Token);
    }

    private async Task RunChargeLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && chargePercent < 100)
            {
                await Task.Delay(80, token);
                chargePercent = Math.Min(100, chargePercent + 4);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ReleaseSpinAsync(PointerEventArgs e)
    {
        if (!isCharging || isSpinning)
        {
            return;
        }

        chargeCts?.Cancel();
        isCharging = false;

        var chargeRatio = chargePercent / 100.0;
        spinDurationMs = (int)Math.Round(4200 + (chargeRatio * 900)); // Full charge -> slightly longer, not abruptly short.
        var fullSpins = 3 + (int)Math.Round(chargeRatio * 9); // Full charge -> much more turns, clearly faster feel.
        await SpinAsync(fullSpins, spinDurationMs);
    }

    private void CancelCharge(PointerEventArgs e)
    {
        if (!isCharging || isSpinning)
        {
            return;
        }

        chargeCts?.Cancel();
        isCharging = false;
        chargePercent = 0;
    }

    private async Task SpinAsync(int fullSpins, int durationMs)
    {
        if (isSpinning)
        {
            return;
        }

        isSpinning = true;
        resultMessage = null;
        labelRotationDegrees = 0;

        var selectedIndex = PickWeightedIndex();
        var selected = Items[selectedIndex];
        var selectedCenter = GetSegmentCenterAngle(selectedIndex);

        var current = rotationDegrees % 360;
        if (current < 0)
        {
            current += 360;
        }

        var target = (360 - selectedCenter) % 360;
        var delta = (target - current + 360) % 360;
        rotationDegrees += (360 * fullSpins) + delta;

        await Task.Delay(durationMs + 100);

        var normalized = rotationDegrees % 360;
        if (normalized < 0)
        {
            normalized += 360;
        }

        isSpinning = false;
        resultMessage = selected.Name;
        labelRotationDegrees = -normalized;
        chargePercent = 0;
    }

    private int PickWeightedIndex()
    {
        var totalWeight = Items.Sum(i => i.Weight);
        var roll = Random.Shared.Next(1, totalWeight + 1);
        var cumulative = 0;
        for (var i = 0; i < Items.Count; i++)
        {
            cumulative += Items[i].Weight;
            if (roll <= cumulative)
            {
                return i;
            }
        }

        return Items.Count - 1;
    }

    private double GetSegmentCenterAngle(int index)
    {
        var totalWeight = Items.Sum(i => i.Weight);
        double cursor = 0;
        for (var i = 0; i < index; i++)
        {
            cursor += GetSliceAngle(Items[i].Weight, totalWeight);
        }

        return cursor + (GetSliceAngle(Items[index].Weight, totalWeight) / 2.0);
    }

    private string BuildWheelBackground()
    {
        var slices = new List<string>();
        double cursorPercent = 0;
        var totalWeight = Items.Sum(i => i.Weight);

        foreach (var item in Items)
        {
            var segmentPercent = (item.Weight * 100.0) / totalWeight;
            var nextPercent = cursorPercent + segmentPercent;
            slices.Add($"{item.Color} {cursorPercent:F3}% {nextPercent:F3}%");
            cursorPercent = nextPercent;
        }

        return $"conic-gradient({string.Join(", ", slices)})";
    }

    private static double GetSliceAngle(int weight, int totalWeight)
    {
        return (weight * 360.0) / totalWeight;
    }

    private sealed record WheelItem(string Name, string ShortLabel, int Weight, string Color);
    private sealed record LabelInfo(string Text, string Style);
}
