@page "/admin"
@attribute [Authorize]
@using RetreatVerses.App.Data
@inject IDataStore DataStore

<h3>관리자 대시보드</h3>

@if (stats.Count == 0)
{
    <p class="text-muted">통계 정보가 없습니다.</p>
}
else
{
    <div class="mt-4">
        <h5 class="mb-3">종합 순위</h5>
        <small class="text-muted d-block mb-2">
            1~3차 가중치: 등록 30% / 암송 50% / 사용적음 20%, 최종 가중치: (1~3차) 60% + (수호실패적음) 40%
        </small>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.FinalRank))">최종순위</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.GroupName))">조 이름</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.RegistrationRank))">등록 순위</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.RecitedRank))">암송 순위</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.UsedLeastRank))">사용적음 순위</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.GuardFailureLeastRank))">수호실패적음 순위</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.PreFinalScore))">1~3 가중점수</button></th>
                        <th><button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => ToggleOverallSort(nameof(OverallRank.FinalScore))">최종점수</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in overallRankings)
                    {
                        <tr>
                            <td>@item.FinalRank</td>
                            <td>@item.GroupName</td>
                            <td>@item.RegistrationRank</td>
                            <td>@item.RecitedRank</td>
                            <td>@item.UsedLeastRank</td>
                            <td>@item.GuardFailureLeastRank</td>
                            <td>@item.PreFinalScore.ToString("0.00")</td>
                            <td>@item.FinalScore.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <small class="text-muted d-block mt-1">
            계산식: ((역등록순위점수×0.30 + 역암송순위점수×0.50 + 역사용적음순위점수×0.20) × 0.60) + (역수호실패적음순위점수×0.40)
        </small>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <h5 class="mb-1">말씀 등록 순위</h5>
            <small class="text-muted d-block mb-2">가중치 30%</small>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>순위</th>
                            <th>조 이름</th>
                            <th>등록 수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rankByRegistrations)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.GroupName</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <h5 class="mb-1">암송 순위</h5>
            <small class="text-muted d-block mb-2">가중치 50%</small>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>순위</th>
                            <th>조 이름</th>
                            <th>암송 수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rankByRecited)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.GroupName</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <h5 class="mb-1">말씀사용 적은 순위</h5>
            <small class="text-muted d-block mb-2">가중치 20%</small>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>순위</th>
                            <th>조 이름</th>
                            <th>사용 수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rankByUsedLeast)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.GroupName</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <h5 class="mb-1">수호실패 적은 순위</h5>
            <small class="text-muted d-block mb-2">최종 반영 가중치 40%</small>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>순위</th>
                            <th>조 이름</th>
                            <th>수호실패 수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rankByGuardFailureLeast)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.GroupName</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h5 class="mb-3">조별 강화 현황</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>조 이름</th>
                        <th>단어</th>
                        <th>수호 강화레벨</th>
                        <th>공격 강화레벨</th>
                        <th>수호실패</th>
                        <th>등록일</th>
                    </tr>
                </thead>
                <tbody>
                    @if (guardSummaries.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted">표시할 정보가 없습니다.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in guardSummaries)
                        {
                            <tr>
                                <td>@item.GroupName</td>
                                <td>@item.Word</td>
                                <td>@item.StarTotal</td>
                                <td>@item.AttackTotal</td>
                                <td>@item.FailureTotal</td>
                                <td>@(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("yyyy-MM-dd") : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<GroupStat> stats = new List<GroupStat>();
    private List<GuardSummary> guardSummaries = new List<GuardSummary>();
    private List<MetricRank> rankByRegistrations = new List<MetricRank>();
    private List<MetricRank> rankByRecited = new List<MetricRank>();
    private List<MetricRank> rankByUsedLeast = new List<MetricRank>();
    private List<MetricRank> rankByGuardFailureLeast = new List<MetricRank>();
    private List<OverallRank> overallRankings = new List<OverallRank>();
    private string overallSortColumn = nameof(OverallRank.FinalRank);
    private bool overallSortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        var groups = await DataStore.GetGroupsAsync();
        var registrations = await DataStore.GetRegistrationsAsync();
        var rewards = await DataStore.GetQuizRewardsAsync();
        var failures = await DataStore.GetGuardFailuresAsync();
        var guardWords = await DataStore.GetGuardWordsAsync();

        stats = groups
            .Select(group =>
            {
                var groupRegistrations = registrations.Where(r => r.GroupId == group.Id).ToList();
                var used = groupRegistrations.Count(r => r.UsedAt.HasValue);
                var recited = groupRegistrations.Count(r => r.RecitedAt.HasValue);
                var total = groupRegistrations.Count;
                return new GroupStat
                {
                    GroupId = group.Id,
                    GroupName = group.Name,
                    Total = total,
                    Used = used,
                    Recited = recited,
                    Pending = total - used - recited
                };
            })
            .OrderByDescending(s => s.Total)
            .ToList();

        var guardStarTotals = rewards
            .Where(r => string.Equals(r.RewardType, "guard", StringComparison.OrdinalIgnoreCase))
            .GroupBy(r => r.GroupId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.StarCount));

        var attackStarTotals = rewards
            .Where(r => string.Equals(r.RewardType, "attack", StringComparison.OrdinalIgnoreCase))
            .GroupBy(r => r.GroupId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.StarCount));

        var guardFailureTotals = failures
            .GroupBy(f => f.GroupId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.CountDelta));

        var latestGuardWords = guardWords
            .GroupBy(w => w.GroupId)
            .Select(g =>
            {
                var latest = g.OrderByDescending(x => x.CreatedAt).First();
                var groupName = groups.FirstOrDefault(gr => gr.Id == g.Key)?.Name ?? "알 수 없음";
                return new GuardWordStat
                {
                    GroupId = g.Key,
                    GroupName = groupName,
                    Word = latest.Word,
                    CreatedAt = latest.CreatedAt
                };
            })
            .ToList();

        guardSummaries = groups
            .Select(group =>
            {
                var latest = latestGuardWords.FirstOrDefault(w => w.GroupId == group.Id);
                var starTotal = guardStarTotals.TryGetValue(group.Id, out var total) ? total : 0;
                var attackTotal = attackStarTotals.TryGetValue(group.Id, out var attack) ? attack : 0;
                var failureTotal = guardFailureTotals.TryGetValue(group.Id, out var failure) ? failure : 0;
                return new GuardSummary
                {
                    GroupName = group.Name,
                    Word = latest?.Word ?? "-",
                    StarTotal = starTotal,
                    AttackTotal = attackTotal,
                    FailureTotal = failureTotal,
                    CreatedAt = latest?.CreatedAt
                };
            })
            .OrderBy(x => x.GroupName)
            .ToList();

        rankByRegistrations = BuildMetricRank(
            stats.Select(s => (s.GroupId, s.GroupName, s.Total)),
            higherIsBetter: true);
        rankByRecited = BuildMetricRank(
            stats.Select(s => (s.GroupId, s.GroupName, s.Recited)),
            higherIsBetter: true);
        rankByUsedLeast = BuildMetricRank(
            stats.Select(s => (s.GroupId, s.GroupName, s.Used)),
            higherIsBetter: false);
        rankByGuardFailureLeast = BuildMetricRank(
            groups.Select(g =>
            {
                var failure = guardFailureTotals.TryGetValue(g.Id, out var value) ? value : 0;
                return (g.Id, g.Name, failure);
            }),
            higherIsBetter: false);

        var registrationRankMap = rankByRegistrations.ToDictionary(x => x.GroupId, x => x.Rank);
        var recitedRankMap = rankByRecited.ToDictionary(x => x.GroupId, x => x.Rank);
        var usedLeastRankMap = rankByUsedLeast.ToDictionary(x => x.GroupId, x => x.Rank);
        var failureLeastRankMap = rankByGuardFailureLeast.ToDictionary(x => x.GroupId, x => x.Rank);
        var groupCount = Math.Max(groups.Count, 1);

        overallRankings = groups
            .Select(group =>
            {
                var registrationRank = registrationRankMap.TryGetValue(group.Id, out var reg) ? reg : groups.Count;
                var recitedRank = recitedRankMap.TryGetValue(group.Id, out var rec) ? rec : groups.Count;
                var usedLeastRank = usedLeastRankMap.TryGetValue(group.Id, out var used) ? used : groups.Count;
                var failureLeastRank = failureLeastRankMap.TryGetValue(group.Id, out var fail) ? fail : groups.Count;

                var registrationScore = (groupCount + 1) - registrationRank;
                var recitedScore = (groupCount + 1) - recitedRank;
                var usedLeastScore = (groupCount + 1) - usedLeastRank;
                var failureLeastScore = (groupCount + 1) - failureLeastRank;

                var preFinalScore = (registrationScore * 0.30) + (recitedScore * 0.50) + (usedLeastScore * 0.20);
                var finalScore = (preFinalScore * 0.60) + (failureLeastScore * 0.40);

                return new OverallRank
                {
                    GroupId = group.Id,
                    GroupName = group.Name,
                    RegistrationRank = registrationRank,
                    RecitedRank = recitedRank,
                    UsedLeastRank = usedLeastRank,
                    GuardFailureLeastRank = failureLeastRank,
                    PreFinalScore = preFinalScore,
                    FinalScore = finalScore
                };
            })
            .OrderByDescending(x => x.FinalScore)
            .ThenByDescending(x => x.PreFinalScore)
            .ThenBy(x => x.GroupName)
            .ToList();

        for (var i = 0; i < overallRankings.Count; i++)
        {
            overallRankings[i].FinalRank = i + 1;
        }

        ApplyOverallSort();
    }

    private void ToggleOverallSort(string column)
    {
        if (string.Equals(overallSortColumn, column, StringComparison.Ordinal))
        {
            overallSortAscending = !overallSortAscending;
        }
        else
        {
            overallSortColumn = column;
            overallSortAscending = string.Equals(column, nameof(OverallRank.FinalRank), StringComparison.Ordinal)
                || string.Equals(column, nameof(OverallRank.GroupName), StringComparison.Ordinal);
        }

        ApplyOverallSort();
    }

    private void ApplyOverallSort()
    {
        var query = overallSortColumn switch
        {
            nameof(OverallRank.GroupName) => overallSortAscending
                ? overallRankings.OrderBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.GroupName),
            nameof(OverallRank.RegistrationRank) => overallSortAscending
                ? overallRankings.OrderBy(x => x.RegistrationRank).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.RegistrationRank).ThenBy(x => x.GroupName),
            nameof(OverallRank.RecitedRank) => overallSortAscending
                ? overallRankings.OrderBy(x => x.RecitedRank).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.RecitedRank).ThenBy(x => x.GroupName),
            nameof(OverallRank.UsedLeastRank) => overallSortAscending
                ? overallRankings.OrderBy(x => x.UsedLeastRank).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.UsedLeastRank).ThenBy(x => x.GroupName),
            nameof(OverallRank.GuardFailureLeastRank) => overallSortAscending
                ? overallRankings.OrderBy(x => x.GuardFailureLeastRank).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.GuardFailureLeastRank).ThenBy(x => x.GroupName),
            nameof(OverallRank.PreFinalScore) => overallSortAscending
                ? overallRankings.OrderBy(x => x.PreFinalScore).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.PreFinalScore).ThenBy(x => x.GroupName),
            nameof(OverallRank.FinalScore) => overallSortAscending
                ? overallRankings.OrderBy(x => x.FinalScore).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.FinalScore).ThenBy(x => x.GroupName),
            _ => overallSortAscending
                ? overallRankings.OrderBy(x => x.FinalRank).ThenBy(x => x.GroupName)
                : overallRankings.OrderByDescending(x => x.FinalRank).ThenBy(x => x.GroupName)
        };

        overallRankings = query.ToList();
    }

    private static List<MetricRank> BuildMetricRank(IEnumerable<(Guid GroupId, string GroupName, int Value)> source, bool higherIsBetter)
    {
        var ordered = higherIsBetter
            ? source.OrderByDescending(x => x.Value).ThenBy(x => x.GroupName).ToList()
            : source.OrderBy(x => x.Value).ThenBy(x => x.GroupName).ToList();

        var result = new List<MetricRank>(ordered.Count);
        var currentRank = 0;
        int? previousValue = null;

        for (var i = 0; i < ordered.Count; i++)
        {
            var item = ordered[i];
            if (previousValue == null || previousValue.Value != item.Value)
            {
                currentRank = i + 1;
                previousValue = item.Value;
            }

            result.Add(new MetricRank
            {
                GroupId = item.GroupId,
                GroupName = item.GroupName,
                Value = item.Value,
                Rank = currentRank
            });
        }

        return result;
    }

    private sealed class GroupStat
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public int Total { get; set; }
        public int Used { get; set; }
        public int Recited { get; set; }
        public int Pending { get; set; }
    }

    private sealed class GuardWordStat
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public string Word { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

    private sealed class GuardSummary
    {
        public string GroupName { get; set; } = string.Empty;
        public string Word { get; set; } = "-";
        public int StarTotal { get; set; }
        public int AttackTotal { get; set; }
        public int FailureTotal { get; set; }
        public DateTime? CreatedAt { get; set; }
    }

    private sealed class MetricRank
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public int Value { get; set; }
        public int Rank { get; set; }
    }

    private sealed class OverallRank
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public int RegistrationRank { get; set; }
        public int RecitedRank { get; set; }
        public int UsedLeastRank { get; set; }
        public int GuardFailureLeastRank { get; set; }
        public double PreFinalScore { get; set; }
        public double FinalScore { get; set; }
        public int FinalRank { get; set; }
    }
}
