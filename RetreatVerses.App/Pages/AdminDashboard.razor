@page "/admin"
@attribute [Authorize]
@using RetreatVerses.App.Data
@inject IDataStore DataStore

<h3>관리자 대시보드</h3>

@if (stats.Count == 0)
{
    <p class="text-muted">통계 정보가 없습니다.</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h5 class="card-title">말씀 많이 등록된 조</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in topByRegistrations)
                        {
                            <li class="d-flex justify-content-between">
                                <span>@item.GroupName</span>
                                <span class="text-muted">@item.Total</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h5 class="card-title">말씀 사용 많은 조</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in topByUsed)
                        {
                            <li class="d-flex justify-content-between">
                                <span>@item.GroupName</span>
                                <span class="text-muted">@item.Used</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-body">
                    <h5 class="card-title">말씀 암송 많은 조</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in topByRecited)
                        {
                            <li class="d-flex justify-content-between">
                                <span>@item.GroupName</span>
                                <span class="text-muted">@item.Recited</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>조 이름</th>
                    <th>등록</th>
                    <th>사용</th>
                    <th>암송</th>
                    <th>미처리</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in stats)
                {
                    <tr>
                        <td>@item.GroupName</td>
                        <td>@item.Total</td>
                        <td>@item.Used</td>
                        <td>@item.Recited</td>
                        <td>@item.Pending</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <h5 class="mb-3">사용별 순위</h5>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>조 이름</th>
                            <th>사용</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in topByUsed)
                        {
                            <tr>
                                <td>@item.GroupName</td>
                                <td>@item.Used</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <h5 class="mb-3">암송별 순위</h5>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>조 이름</th>
                            <th>암송</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in topByRecited)
                        {
                            <tr>
                                <td>@item.GroupName</td>
                                <td>@item.Recited</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h5 class="mb-3">조별 수호 현황</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>조 이름</th>
                        <th>단어</th>
                        <th>수호의 별</th>
                        <th>수호실패</th>
                        <th>등록일</th>
                    </tr>
                </thead>
                <tbody>
                    @if (guardSummaries.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-muted">표시할 정보가 없습니다.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in guardSummaries)
                        {
                            <tr>
                                <td>@item.GroupName</td>
                                <td>@item.Word</td>
                                <td>@item.StarTotal</td>
                                <td>@item.FailureTotal</td>
                                <td>@(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("yyyy-MM-dd") : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<GroupStat> stats = new List<GroupStat>();
    private List<GroupStat> topByRegistrations = new List<GroupStat>();
    private List<GroupStat> topByUsed = new List<GroupStat>();
    private List<GroupStat> topByRecited = new List<GroupStat>();
    private List<GuardSummary> guardSummaries = new List<GuardSummary>();

    protected override async Task OnInitializedAsync()
    {
        var groups = await DataStore.GetGroupsAsync();
        var registrations = await DataStore.GetRegistrationsAsync();
        var rewards = await DataStore.GetQuizRewardsAsync();
        var failures = await DataStore.GetGuardFailuresAsync();
        var guardWords = await DataStore.GetGuardWordsAsync();

        stats = groups
            .Select(group =>
            {
                var groupRegistrations = registrations.Where(r => r.GroupId == group.Id).ToList();
                var used = groupRegistrations.Count(r => r.UsedAt.HasValue);
                var recited = groupRegistrations.Count(r => r.RecitedAt.HasValue);
                var total = groupRegistrations.Count;
                return new GroupStat
                {
                    GroupName = group.Name,
                    Total = total,
                    Used = used,
                    Recited = recited,
                    Pending = total - used - recited
                };
            })
            .OrderByDescending(s => s.Total)
            .ToList();

        var guardStarTotals = rewards
            .Where(r => string.Equals(r.RewardType, "guard", StringComparison.OrdinalIgnoreCase))
            .GroupBy(r => r.GroupId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.StarCount));

        var guardFailureTotals = failures
            .GroupBy(f => f.GroupId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.CountDelta));

        var latestGuardWords = guardWords
            .GroupBy(w => w.GroupId)
            .Select(g =>
            {
                var latest = g.OrderByDescending(x => x.CreatedAt).First();
                var groupName = groups.FirstOrDefault(gr => gr.Id == g.Key)?.Name ?? "알 수 없음";
                return new GuardWordStat
                {
                    GroupId = g.Key,
                    GroupName = groupName,
                    Word = latest.Word,
                    CreatedAt = latest.CreatedAt
                };
            })
            .ToList();

        guardSummaries = groups
            .Select(group =>
            {
                var latest = latestGuardWords.FirstOrDefault(w => w.GroupId == group.Id);
                var starTotal = guardStarTotals.TryGetValue(group.Id, out var total) ? total : 0;
                var failureTotal = guardFailureTotals.TryGetValue(group.Id, out var failure) ? failure : 0;
                return new GuardSummary
                {
                    GroupName = group.Name,
                    Word = latest?.Word ?? "-",
                    StarTotal = starTotal,
                    FailureTotal = failureTotal,
                    CreatedAt = latest?.CreatedAt
                };
            })
            .OrderBy(x => x.GroupName)
            .ToList();

        topByRegistrations = stats
            .OrderByDescending(s => s.Total)
            .ThenBy(s => s.GroupName)
            .Take(5)
            .ToList();

        topByUsed = stats
            .OrderByDescending(s => s.Used)
            .ThenBy(s => s.GroupName)
            .Take(5)
            .ToList();

        topByRecited = stats
            .OrderByDescending(s => s.Recited)
            .ThenBy(s => s.GroupName)
            .Take(5)
            .ToList();
    }

    private sealed class GroupStat
    {
        public string GroupName { get; set; } = string.Empty;
        public int Total { get; set; }
        public int Used { get; set; }
        public int Recited { get; set; }
        public int Pending { get; set; }
    }

    private sealed class GuardWordStat
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = string.Empty;
        public string Word { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

    private sealed class GuardSummary
    {
        public string GroupName { get; set; } = string.Empty;
        public string Word { get; set; } = "-";
        public int StarTotal { get; set; }
        public int FailureTotal { get; set; }
        public DateTime? CreatedAt { get; set; }
    }
}
