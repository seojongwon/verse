@page "/admin/groups"
@attribute [Authorize]
@using RetreatVerses.App.Data
@inject IDataStore DataStore
@implements IDisposable
@using System.Threading

<h3>조 관리</h3>

@if (showToast && !string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="admin-toast" role="status" aria-live="polite">
        @toastMessage
    </div>
}

<style>
    .admin-toast {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 1080;
        background: #1f2937;
        color: #f9fafb;
        padding: 0.65rem 0.9rem;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        font-size: 0.9rem;
        animation: toast-in 0.2s ease-out;
    }

    @@keyframes toast-in {
        from {
            transform: translateY(8px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .star-col {
        width: 6.5rem;
        min-width: 6.5rem;
    }

    .star-col .form-control {
        padding-left: 0.4rem;
        padding-right: 0.4rem;
    }
</style>

<div class="mb-3">
    <label class="form-label">새 조 이름</label>
    <div class="group-add-row">
        <input class="form-control group-add-input" @bind="newGroupName" placeholder="예: 1조" />
        <input class="form-control group-add-input" type="password" autocomplete="new-password" @bind="newGroupPassword" placeholder="비밀번호" />
        <button class="btn btn-primary" @onclick="AddGroupAsync">추가</button>
    </div>
    <small class="text-muted">조별 비밀번호는 말씀 사용 시 필요합니다.</small>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-outline-danger" disabled="@(selectedGroupIds.Count == 0)" @onclick="DeleteSelectedAsync">선택 삭제</button>
    <button class="btn btn-outline-danger" disabled="@(groups.Count == 0)" @onclick="DeleteAllAsync">전체 삭제</button>
    <button class="btn btn-outline-secondary" @onclick="ToggleGroupIdVisibility">
        @(showGroupId ? "조 ID 숨기기" : "조 ID 보이기")
    </button>
</div>

@if (groups.Count == 0)
{
    <p class="text-muted">등록된 조가 없습니다.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th class="text-center align-middle">
                        <div class="d-flex justify-content-center align-items-center">
                            <input class="md-checkbox" type="checkbox" @bind="IsAllSelected" />
                        </div>
                    </th>
                    <th class="text-start align-middle">조 이름</th>
                    <th class="text-start align-middle">비밀번호</th>
                    <th class="text-start align-middle">수호단어</th>
                    <th class="text-start align-middle star-col">수호의 별</th>
                    <th class="text-start align-middle star-col">공격의 별</th>
                    <th class="text-start align-middle">작업/링크</th>
                    @if (showGroupId)
                    {
                        <th class="text-start align-middle">조 ID</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var group in groups)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <input class="md-checkbox" type="checkbox" checked="@selectedGroupIds.Contains(group.Id)" @onchange="(e => ToggleGroupSelection(group.Id, e))" />
                        </td>
                        <td>
                            <input class="form-control" @bind="group.Name" />
                        </td>
                        <td>
                            <input class="form-control" type="password" autocomplete="new-password"
                                   placeholder="변경 시 입력"
                                   @bind-value:get="GetPasswordInput(group.Id)"
                                   @bind-value:set="value => SetPasswordInput(group.Id, value)"
                                   @bind-value:event="oninput" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenGuardWordPanel(group)">수호단어 등록</button>
                        </td>
                        <td class="star-col">
                            <div class="d-flex flex-column gap-1">
                                <small class="text-muted">현재: @GetGuardStarTotal(group.Id)</small>
                                <input class="form-control form-control-sm"
                                       type="number" min="0"
                                       @bind-value:get="GetGuardStarInput(group.Id)"
                                       @bind-value:set="value => SetGuardStarInput(group.Id, value)"
                                       @bind-value:event="oninput" />
                            </div>
                        </td>
                        <td class="star-col">
                            <div class="d-flex flex-column gap-1">
                                <small class="text-muted">현재: @GetAttackStarTotal(group.Id)</small>
                                <input class="form-control form-control-sm"
                                       type="number" min="0"
                                       @bind-value:get="GetAttackStarInput(group.Id)"
                                       @bind-value:set="value => SetAttackStarInput(group.Id, value)"
                                       @bind-value:event="oninput" />
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveGroupAndStarsAsync(group)">저장</button>
                            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteGroupAsync(group)">삭제</button>
                            <a class="btn btn-sm btn-outline-secondary me-2" href="/group/@group.Id/verses">목록</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/use/@group.Id">사용</a>
                        </td>
                        @if (showGroupId)
                        {
                            <td class="text-muted">@group.Id</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (guardWordGroupId != null)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">수호단어 등록 - @guardWordGroupName</h5>
                @if (guardWordVerse == null)
                {
                    <p class="text-muted">수호용으로 등록된 말씀이 없습니다.</p>
                }
                else
                {
                    <p class="text-muted mb-2">랜덤 말씀</p>
                    <p>@guardWordVerse.Text</p>
                    <div class="group-add-row">
                        <select class="form-select group-add-input" @bind="selectedGuardUsePurpose">
                            @foreach (var purpose in purposes)
                            {
                                <option value="@purpose">@purpose</option>
                            }
                        </select>
                        <input class="form-control group-add-input" @bind="guardWordInput" placeholder="두 글자 이상의 단어" />
                        <button class="btn btn-outline-secondary" @onclick="RefreshGuardVerse">말씀 다시 뽑기</button>
                        <button class="btn btn-outline-primary" @onclick="AddGuardWordAsync">등록</button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(guardWordMessage))
                {
                    <small class="text-muted">@guardWordMessage</small>
                }
            </div>
        </div>
    }
}

@if (guardWordGroupId != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">성경 퀴즈</h5>
            @if (quizzes.Count == 0)
            {
                <p class="text-muted">등록된 퀴즈가 없습니다.</p>
            }
            else if (activeQuiz == null)
            {
                <p class="text-muted">문제를 불러오지 못했습니다.</p>
            }
            else
            {
                <p class="text-muted mb-2">랜덤 문제</p>
                <p>@activeQuiz.Question</p>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="fw-bold fs-5">타이머: @timerDisplay</span>
                    <button class="btn btn-outline-primary" @onclick="StartTimer" disabled="@timerRunning">시작</button>
                    <button class="btn btn-outline-danger" @onclick="StopTimer" disabled="@(!timerRunning)">정지</button>
                    <button class="btn btn-outline-secondary" @onclick="PickRandomQuiz">문제 다시 뽑기</button>
                </div>
                <div class="mt-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <label class="form-label mb-0">응답 시간(초)</label>
                        <input class="form-control form-control-sm" style="max-width: 120px;"
                               type="number" min="0" @bind="quizResponseSeconds" />
                    </div>
                    <div class="mt-2 d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="rewardType"
                                   value="@RewardTypeGuard"
                                   checked="@(selectedRewardType == RewardTypeGuard)"
                                   @onchange="() => selectedRewardType = RewardTypeGuard"
                                   id="reward-guard" />
                            <label class="form-check-label" for="reward-guard">수호의 별 (시스템 저장)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="rewardType"
                                   value="@RewardTypeAttack"
                                   checked="@(selectedRewardType == RewardTypeAttack)"
                                   @onchange="() => selectedRewardType = RewardTypeAttack"
                                   id="reward-attack" />
                            <label class="form-check-label" for="reward-attack">공격의 별 (칩 지급)</label>
                        </div>
                    </div>
                    <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-primary" @onclick="SaveQuizRewardAsync">저장</button>
                        @if (!string.IsNullOrWhiteSpace(quizRewardMessage))
                        {
                            <small class="text-muted">@quizRewardMessage</small>
                        }
                    </div>
                    <small class="text-muted d-block mt-2">
                        5초 이내 3개, 15초 이내 2개, 그 이상 1개
                    </small>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Group> groups = new List<Group>();
    private string newGroupName = string.Empty;
    private string newGroupPassword = string.Empty;
    private HashSet<Guid> selectedGroupIds = new HashSet<Guid>();
    private bool isAllSelected;
    private readonly Dictionary<Guid, string> passwordInputs = new Dictionary<Guid, string>();
    private readonly Dictionary<Guid, string> guardStarInputs = new Dictionary<Guid, string>();
    private readonly Dictionary<Guid, string> attackStarInputs = new Dictionary<Guid, string>();
    private readonly Dictionary<Guid, int> guardStarTotals = new Dictionary<Guid, int>();
    private readonly Dictionary<Guid, int> attackStarTotals = new Dictionary<Guid, int>();
    private string? toastMessage;
    private bool showToast;
    private CancellationTokenSource? toastCts;
    private bool showGroupId;
    private const string GuardPurpose = "수호용";
    private List<Verse> guardVerses = new List<Verse>();
    private List<QuizEntry> quizzes = new List<QuizEntry>();
    private QuizEntry? activeQuiz;
    private System.Timers.Timer? quizTimer;
    private bool quizTimerInitialized;
    private bool timerRunning;
    private int elapsedSeconds;
    private int quizResponseSeconds;
    private const string RewardTypeGuard = "guard";
    private const string RewardTypeAttack = "attack";
    private string selectedRewardType = RewardTypeGuard;
    private string? quizRewardMessage;
    private Guid? guardWordGroupId;
    private string? guardWordGroupName;
    private Verse? guardWordVerse;
    private string guardWordInput = string.Empty;
    private string? guardWordMessage;
    private List<string> purposes = new List<string>();
    private string selectedGuardUsePurpose = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task AddGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(newGroupName) || string.IsNullOrWhiteSpace(newGroupPassword))
        {
            return;
        }

        await DataStore.AddGroupAsync(newGroupName, newGroupPassword);
        newGroupName = string.Empty;
        newGroupPassword = string.Empty;
        await ReloadAsync();
    }

    private async Task SaveGroupAndStarsAsync(Group group)
    {
        if (!TryGetStarInputs(group.Id, out var desiredGuard, out var desiredAttack, out var errorMessage))
        {
            await ShowToastAsync(errorMessage);
            return;
        }

        passwordInputs.TryGetValue(group.Id, out var password);
        await DataStore.UpdateGroupAsync(group.Id, group.Name, string.IsNullOrWhiteSpace(password) ? null : password);
        passwordInputs.Remove(group.Id);

        var currentGuard = GetGuardStarTotal(group.Id);
        var currentAttack = GetAttackStarTotal(group.Id);
        var guardDelta = desiredGuard - currentGuard;
        var attackDelta = desiredAttack - currentAttack;

        if (guardDelta != 0)
        {
            await DataStore.AddStarAdjustmentAsync(group.Id, RewardTypeGuard, guardDelta);
        }

        if (attackDelta != 0)
        {
            await DataStore.AddStarAdjustmentAsync(group.Id, RewardTypeAttack, attackDelta);
        }

        await ReloadAsync();
        await ShowToastAsync("저장되었습니다.");
    }

    private async Task ReloadAsync()
    {
        groups = (await DataStore.GetGroupsAsync()).ToList();
        var verses = await DataStore.GetVersesAsync();
        guardVerses = verses.Where(v => string.Equals(v.Type, GuardPurpose, StringComparison.OrdinalIgnoreCase)).ToList();
        quizzes = (await DataStore.GetQuizzesAsync()).ToList();
        var rewards = await DataStore.GetQuizRewardsAsync();
        purposes = (await DataStore.GetVersePurposesAsync())
            .Where(p => !string.Equals(p, GuardPurpose, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (purposes.Count > 0 && string.IsNullOrWhiteSpace(selectedGuardUsePurpose))
        {
            selectedGuardUsePurpose = purposes[0];
        }
        LoadStarTotals(rewards);
        SyncGuardWordPanel();
        SyncSelection();
    }

    private async Task DeleteGroupAsync(Group group)
    {
        await DataStore.DeleteGroupAsync(group.Id);
        await ReloadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        if (selectedGroupIds.Count == 0)
        {
            return;
        }

        await DataStore.DeleteGroupsAsync(selectedGroupIds);
        await ReloadAsync();
    }

    private async Task DeleteAllAsync()
    {
        await DataStore.DeleteAllGroupsAsync();
        await ReloadAsync();
    }

    private void ToggleGroupIdVisibility()
    {
        showGroupId = !showGroupId;
    }

    private void ToggleGroupSelection(Guid id, ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked)
        {
            selectedGroupIds.Add(id);
        }
        else
        {
            selectedGroupIds.Remove(id);
        }

        isAllSelected = groups.Count > 0 && selectedGroupIds.Count == groups.Count;
    }

    private void SyncSelection()
    {
        selectedGroupIds = selectedGroupIds
            .Where(id => groups.Any(g => g.Id == id))
            .ToHashSet();
        isAllSelected = groups.Count > 0 && selectedGroupIds.Count == groups.Count;
    }

    private string GetPasswordInput(Guid id)
    {
        return passwordInputs.TryGetValue(id, out var value) ? value : string.Empty;
    }

    private void SetPasswordInput(Guid id, string? value)
    {
        passwordInputs[id] = value ?? string.Empty;
    }

    private int GetGuardStarTotal(Guid id)
    {
        return guardStarTotals.TryGetValue(id, out var value) ? value : 0;
    }

    private int GetAttackStarTotal(Guid id)
    {
        return attackStarTotals.TryGetValue(id, out var value) ? value : 0;
    }

    private string GetGuardStarInput(Guid id)
    {
        return guardStarInputs.TryGetValue(id, out var value) ? value : GetGuardStarTotal(id).ToString();
    }

    private void SetGuardStarInput(Guid id, string? value)
    {
        guardStarInputs[id] = value ?? string.Empty;
    }

    private string GetAttackStarInput(Guid id)
    {
        return attackStarInputs.TryGetValue(id, out var value) ? value : GetAttackStarTotal(id).ToString();
    }

    private void SetAttackStarInput(Guid id, string? value)
    {
        attackStarInputs[id] = value ?? string.Empty;
    }

    private void LoadStarTotals(IReadOnlyList<QuizRewardEntry> rewards)
    {
        guardStarTotals.Clear();
        attackStarTotals.Clear();

        foreach (var group in groups)
        {
            var guardTotal = rewards
                .Where(r => r.GroupId == group.Id && string.Equals(r.RewardType, RewardTypeGuard, StringComparison.OrdinalIgnoreCase))
                .Sum(r => r.StarCount);
            var attackTotal = rewards
                .Where(r => r.GroupId == group.Id && string.Equals(r.RewardType, RewardTypeAttack, StringComparison.OrdinalIgnoreCase))
                .Sum(r => r.StarCount);

            guardStarTotals[group.Id] = guardTotal;
            attackStarTotals[group.Id] = attackTotal;
            guardStarInputs[group.Id] = guardTotal.ToString();
            attackStarInputs[group.Id] = attackTotal.ToString();
        }
    }

    private void OpenGuardWordPanel(Group group)
    {
        guardWordGroupId = group.Id;
        guardWordGroupName = group.Name;
        guardWordInput = string.Empty;
        guardWordMessage = null;
        guardWordVerse = PickRandomGuardVerse();
        activeQuiz = PickRandomQuizInternal();
        quizRewardMessage = null;
        selectedRewardType = RewardTypeGuard;
        ResetTimer();
    }

    private bool TryGetStarInputs(Guid groupId, out int desiredGuard, out int desiredAttack, out string errorMessage)
    {
        desiredGuard = 0;
        desiredAttack = 0;
        errorMessage = string.Empty;

        if (!int.TryParse(GetGuardStarInput(groupId), out desiredGuard) || desiredGuard < 0)
        {
            errorMessage = "수호의 별은 0 이상으로 입력해 주세요.";
            return false;
        }

        if (!int.TryParse(GetAttackStarInput(groupId), out desiredAttack) || desiredAttack < 0)
        {
            errorMessage = "공격의 별은 0 이상으로 입력해 주세요.";
            return false;
        }

        return true;
    }

    private async Task ShowToastAsync(string message)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        toastMessage = message;
        showToast = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(2500, toastCts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        showToast = false;
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshGuardVerse()
    {
        guardWordVerse = PickRandomGuardVerse();
        guardWordMessage = null;
    }

    private Verse? PickRandomGuardVerse()
    {
        if (guardVerses.Count == 0)
        {
            return null;
        }

        var index = Random.Shared.Next(guardVerses.Count);
        return guardVerses[index];
    }

    private void SyncGuardWordPanel()
    {
        if (guardWordGroupId == null)
        {
            return;
        }

        var group = groups.FirstOrDefault(g => g.Id == guardWordGroupId.Value);
        if (group == null)
        {
            guardWordGroupId = null;
            guardWordGroupName = null;
            guardWordVerse = null;
            guardWordInput = string.Empty;
            guardWordMessage = null;
            return;
        }

        guardWordGroupName = group.Name;
        if (guardVerses.Count == 0)
        {
            guardWordVerse = null;
        }
        else if (guardWordVerse == null || !guardVerses.Any(v => v.Id == guardWordVerse.Id))
        {
            guardWordVerse = PickRandomGuardVerse();
        }

        if (purposes.Count > 0 && (string.IsNullOrWhiteSpace(selectedGuardUsePurpose) || !purposes.Contains(selectedGuardUsePurpose)))
        {
            selectedGuardUsePurpose = purposes[0];
        }

        if (quizzes.Count == 0)
        {
            activeQuiz = null;
        }
        else if (activeQuiz == null || !quizzes.Any(q => q.Id == activeQuiz.Id))
        {
            activeQuiz = PickRandomQuizInternal();
            ResetTimer();
        }
    }

    private async Task AddGuardWordAsync()
    {
        guardWordMessage = null;
        if (guardWordGroupId == null)
        {
            guardWordMessage = "먼저 조를 선택해 주세요.";
            return;
        }

        if (guardVerses.Count == 0 || guardWordVerse == null)
        {
            guardWordMessage = "수호용으로 등록된 말씀이 없습니다.";
            return;
        }

        if (purposes.Count == 0 || string.IsNullOrWhiteSpace(selectedGuardUsePurpose))
        {
            guardWordMessage = "먼저 사용 용도를 등록해 주세요.";
            return;
        }

        var group = groups.FirstOrDefault(g => g.Id == guardWordGroupId.Value);
        if (group == null)
        {
            guardWordMessage = "선택한 조를 찾을 수 없습니다.";
            return;
        }

        var verse = guardWordVerse;
        var word = guardWordInput.Trim();
        if (word.Length < 2)
        {
            guardWordMessage = "두 글자 이상의 단어만 등록할 수 있습니다.";
            return;
        }

        if (!verse.Text.Contains(word, StringComparison.Ordinal))
        {
            guardWordMessage = "말씀에 포함된 단어만 등록할 수 있습니다.";
            return;
        }

        await DataStore.AddGuardWordAsync(group.Id, selectedGuardUsePurpose, verse.Text, word);
        guardWordInput = string.Empty;
        guardWordMessage = "단어가 등록되었습니다.";
    }

    private string timerDisplay => TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss");

    private void StartTimer()
    {
        if (timerRunning)
        {
            return;
        }

        timerRunning = true;
        if (!quizTimerInitialized)
        {
            quizTimer = new System.Timers.Timer(1000);
            quizTimer.AutoReset = true;
            quizTimer.Elapsed += (_, _) =>
            {
                elapsedSeconds++;
                _ = InvokeAsync(StateHasChanged);
            };
            quizTimerInitialized = true;
        }
        quizTimer.Start();
    }

    private void StopTimer()
    {
        if (!timerRunning)
        {
            return;
        }

        timerRunning = false;
        quizTimer?.Stop();
        quizResponseSeconds = elapsedSeconds;
    }

    private void ResetTimer()
    {
        StopTimer();
        elapsedSeconds = 0;
        quizResponseSeconds = 0;
    }

    private void PickRandomQuiz()
    {
        activeQuiz = PickRandomQuizInternal();
        quizRewardMessage = null;
        selectedRewardType = RewardTypeGuard;
        ResetTimer();
    }

    private async Task SaveQuizRewardAsync()
    {
        quizRewardMessage = null;

        if (guardWordGroupId == null)
        {
            quizRewardMessage = "먼저 조를 선택해 주세요.";
            return;
        }

        if (activeQuiz == null)
        {
            quizRewardMessage = "퀴즈 문제가 없습니다.";
            return;
        }

        var responseSeconds = quizResponseSeconds > 0 ? quizResponseSeconds : elapsedSeconds;
        if (responseSeconds <= 0)
        {
            quizRewardMessage = "응답 시간을 입력하거나 타이머를 사용해 주세요.";
            return;
        }

        var starCount = CalculateStarCount(responseSeconds);
        await DataStore.AddQuizRewardAsync(guardWordGroupId.Value, activeQuiz.Id, responseSeconds, selectedRewardType, starCount);

        quizRewardMessage = selectedRewardType == RewardTypeGuard
            ? $"수호의 별 {starCount}개를 저장했습니다."
            : $"공격의 별 {starCount}개 지급을 기록했습니다.";
    }

    private static int CalculateStarCount(int responseSeconds)
    {
        if (responseSeconds <= 5)
        {
            return 3;
        }

        if (responseSeconds <= 15)
        {
            return 2;
        }

        return 1;
    }

    private QuizEntry? PickRandomQuizInternal()
    {
        if (quizzes.Count == 0)
        {
            return null;
        }

        var index = Random.Shared.Next(quizzes.Count);
        return quizzes[index];
    }

    public void Dispose()
    {
        quizTimer?.Stop();
        quizTimer?.Dispose();
        toastCts?.Cancel();
        toastCts?.Dispose();
    }

    private bool IsAllSelected
    {
        get => isAllSelected;
        set
        {
            isAllSelected = value;
            if (isAllSelected)
            {
                selectedGroupIds = groups.Select(g => g.Id).ToHashSet();
            }
            else
            {
                selectedGroupIds.Clear();
            }
        }
    }

}
