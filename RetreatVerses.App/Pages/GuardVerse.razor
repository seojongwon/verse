@page "/guard"
@using RetreatVerses.App.Data
@inject IDataStore DataStore

<section class="guard-verse">
    <header class="guard-verse__header">
        <p class="guard-verse__eyebrow">수호용 말씀</p>
        <h3 class="guard-verse__title">랜덤 말씀</h3>
        <p class="guard-verse__subtitle">수호용으로 등록된 말씀 중 하나가 표시됩니다.</p>
    </header>

    <div class="guard-verse__panel">
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="guard-verse__message">@message</p>
        }
        else if (!string.IsNullOrWhiteSpace(selectedVerse))
        {
            <p class="guard-verse__text">@selectedVerse</p>
        }

        <div class="guard-verse__form">
            <label class="guard-verse__label" for="guardWordInput">말씀 속 단어</label>
            <div class="guard-verse__form-row">
                <input id="guardWordInput"
                       class="guard-verse__input"
                       placeholder="두 글자 이상의 명사"
                       @bind="inputWord" />
                <button type="button" class="guard-verse__button" @onclick="RegisterAsync">등록</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(actionMessage))
            {
                <p class="guard-verse__action-message">@actionMessage</p>
            }
        </div>

        <div class="guard-verse__actions">
            <button type="button" class="guard-verse__button" @onclick="PickRandomAsync">다시 뽑기</button>
        </div>
    </div>
</section>

@code {
    private const string GuardPurpose = "수호용";
    private readonly List<Verse> guardVerses = new List<Verse>();
    private string? selectedVerse;
    private string? message;
    private string inputWord = string.Empty;
    private string? actionMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadVersesAsync();
        PickRandom();
    }

    private async Task PickRandomAsync()
    {
        if (guardVerses.Count == 0)
        {
            await LoadVersesAsync();
        }

        PickRandom();
    }

    private async Task LoadVersesAsync()
    {
        guardVerses.Clear();
        var verses = await DataStore.GetVersesAsync();
        guardVerses.AddRange(verses.Where(v => string.Equals(v.Type, GuardPurpose, StringComparison.OrdinalIgnoreCase)));
    }

    private void PickRandom()
    {
        if (guardVerses.Count == 0)
        {
            selectedVerse = null;
            message = "수호용으로 등록된 말씀이 없습니다.";
            return;
        }

        message = null;
        var index = Random.Shared.Next(guardVerses.Count);
        selectedVerse = guardVerses[index].Text;
        actionMessage = null;
    }

    private async Task RegisterAsync()
    {
        actionMessage = null;
        if (string.IsNullOrWhiteSpace(selectedVerse))
        {
            actionMessage = "먼저 말씀을 불러와 주세요.";
            return;
        }

        var word = inputWord.Trim();
        if (word.Length < 2)
        {
            actionMessage = "두 글자 이상의 단어만 등록할 수 있습니다.";
            return;
        }

        if (!selectedVerse.Contains(word, StringComparison.Ordinal))
        {
            actionMessage = "말씀에 포함된 단어만 등록할 수 있습니다.";
            return;
        }

        await DataStore.AddGuardWordAsync(selectedVerse, word);
        inputWord = string.Empty;
        actionMessage = "단어가 등록되었습니다.";
    }
}
