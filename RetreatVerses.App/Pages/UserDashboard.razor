@page "/user"
@using RetreatVerses.App.Data
@inject IDataStore DataStore

<section class="user-dashboard">
    <header class="user-dashboard__header">
        <p class="user-dashboard__eyebrow">사용자 대시보드</p>
        <h3 class="user-dashboard__title">@dashboardTitle</h3>
    </header>

    <div class="user-dashboard__panel">
        @if (!isAuthorized)
        {
            <div class="user-dashboard__auth">
                <label class="user-dashboard__label" for="groupNameInput">조 이름</label>
                <input id="groupNameInput" class="form-control" placeholder="예: 1조" @bind="groupNameInput" />
                <label class="user-dashboard__label mt-3" for="groupPasswordInput">조 비밀번호</label>
                <input id="groupPasswordInput" class="form-control" type="password" autocomplete="current-password"
                       placeholder="비밀번호 입력" @bind="groupPasswordInput" />
                <button type="button" class="btn btn-primary mt-3" @onclick="FindGroupByNameAsync">입장</button>
                @if (!string.IsNullOrWhiteSpace(searchMessage))
                {
                    <p class="text-muted mt-2">@searchMessage</p>
                }
            </div>
        }
        else
        {
            <div class="user-dashboard__metric">
                <span class="user-dashboard__label">등록된 말씀</span>
                <strong class="user-dashboard__value">@totalVerses</strong>
            </div>

            <div class="user-dashboard__section">
                <p class="user-dashboard__section-title">용도별 말씀 수</p>
                @if (purposeCounts.Count == 0)
                {
                    <p class="text-muted">등록된 말씀이 없습니다.</p>
                }
                else
                {
                    <ul class="user-dashboard__list">
                        @foreach (var item in purposeCounts)
                        {
                            <li class="user-dashboard__list-item">
                                <span>@item.Purpose</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="user-dashboard__section">
                <p class="user-dashboard__section-title">수호단어</p>
                @if (latestGuardWord == null)
                {
                    <p class="text-muted">등록된 단어가 없습니다.</p>
                }
                else
                {
                    <div class="user-dashboard__word">
                        <strong>@latestGuardWord.Word</strong>
                    </div>
                }
            </div>

            <div class="user-dashboard__section">
                <p class="user-dashboard__section-title">수호의 별</p>
                <div class="user-dashboard__metric">
                    <span class="user-dashboard__label">수호의 별</span>
                    <strong class="user-dashboard__value">@guardStarTotal</strong>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private int totalVerses;
    private List<PurposeCount> purposeCounts = new List<PurposeCount>();
    private GuardWordEntry? latestGuardWord;
    private int guardStarTotal;
    private string groupNameInput = string.Empty;
    private string groupPasswordInput = string.Empty;
    private string? searchMessage;
    private bool isAuthorized;
    private Group? group;
    private string dashboardTitle => group == null ? "말씀 현황" : $"{group.Name}조 말씀 현황";

    private async Task FindGroupByNameAsync()
    {
        searchMessage = null;
        isAuthorized = false;

        if (string.IsNullOrWhiteSpace(groupNameInput))
        {
            searchMessage = "조 이름을 입력해 주세요.";
            return;
        }

        var groups = await DataStore.GetGroupsAsync();
        var normalized = groupNameInput.Trim();
        group = groups.FirstOrDefault(g => string.Equals(g.Name, normalized, StringComparison.OrdinalIgnoreCase));

        if (group == null)
        {
            searchMessage = "해당 조를 찾을 수 없습니다.";
            return;
        }

        if (string.IsNullOrWhiteSpace(groupPasswordInput))
        {
            searchMessage = "조 비밀번호를 입력해 주세요.";
            return;
        }

        if (!await DataStore.VerifyGroupPasswordAsync(group.Id, groupPasswordInput))
        {
            searchMessage = "비밀번호가 일치하지 않습니다.";
            return;
        }

        isAuthorized = true;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        var verses = await DataStore.GetVersesAsync();
        var verseMap = verses.ToDictionary(v => v.Id, v => v);
        var registrations = await DataStore.GetRegistrationsForGroupAsync(group!.Id);
        var registeredVerses = registrations
            .Select(r => r.VerseId)
            .Distinct()
            .Select(id => verseMap.TryGetValue(id, out var verse) ? verse : null)
            .Where(v => v != null)
            .Select(v => v!)
            .ToList();

        totalVerses = registeredVerses.Count;
        purposeCounts = registeredVerses
            .GroupBy(v => v.Type)
            .Select(g => new PurposeCount(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Purpose)
            .ToList();

        var guardWords = await DataStore.GetGuardWordsAsync();
        latestGuardWord = guardWords
            .Where(w => w.GroupId == group.Id)
            .OrderByDescending(w => w.CreatedAt)
            .FirstOrDefault();

        var rewards = await DataStore.GetQuizRewardsAsync();
        guardStarTotal = rewards
            .Where(r => r.GroupId == group.Id && string.Equals(r.RewardType, "guard", StringComparison.OrdinalIgnoreCase))
            .Sum(r => r.StarCount);
    }

    private sealed class PurposeCount
    {
        public PurposeCount(string purpose, int count)
        {
            Purpose = purpose;
            Count = count;
        }

        public string Purpose { get; }
        public int Count { get; }
    }
}
